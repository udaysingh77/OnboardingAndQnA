# Server
NODE_ENV=development
PORT=4000

# Database (SQL Server) - set by scripts/setup-db.ps1 (run as Administrator)
DATABASE_URL="sqlserver://localhost:1433;database=Dreamsoft_UAT;user=iprs_app;password=iprs_app;encrypt=true;trustServerCertificate=true;"
# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d
JWT_ISSUER=iprs

# Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

# OTP provider: 'mock' (local/testing) or 'sms' (MSG91, requires MSG91 keys).
OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_MOCK_VALUE=123456

# MSG91 (only required when OTP_PROVIDER=sms)
MSG91_AUT_KEY=
MSG91_TEMP_ID=
MSG91_OTP_LENGTH=4
MSG91_OTP_EXPIRY=10

# Registration
DEFAULT_REGISTRATION_STATUS=started
REGISTRATION_TOTAL_STEPS=10


# Spotify API credentials

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where a member is told to write if the pre-payment review shows something wrong.
SUPPORT_CONTACT=Info@iprsolutions.in or theiprsolutions@gmail.com

# --- Work links (Spotify / YouTube songs a member claims) ---
# In-house credits service. Returns ROLE-LABELLED credits (composer / lyricist / producer), which is
# what fills Author_Composer and Author_Lyricist - see AGENTS.md. One endpoint per platform:
#   Spotify  GET /credits?track=<url>    structured contributors with roles
#   YouTube  GET /youtube/raw?url=<url>  raw InnerTube, parsed in musicCredits.service.js
MUSIC_CREDITS_API_BASE_URL=https://spotify.choira.in
MUSIC_CREDITS_REQUEST_TIMEOUT_MS=30000
# false skips it and falls back to the Spotify Web API + oEmbed/Gemini path below.
MUSIC_CREDITS_ENABLED=true

# Fallback path, used when the credits service is disabled, unreachable, or has nothing for a link.
# YouTube metadata comes from the keyless youtube.com/oembed endpoint - there is no YouTube
# Data API key for this project (the Google OAuth client id/secret cannot fetch video metadata).
YOUTUBE_REQUEST_TIMEOUT_MS=10000
# Gemini splits a YouTube video title into song / artists / album. Optional: leave the key blank
# and the flow falls back to showing the raw video title instead of breaking.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_REQUEST_TIMEOUT_MS=15000


# OCR provider: 'http' (real ocr.choira.io service) or 'stub' (local dev, no network).
OCR_PROVIDER=http
OCR_API_BASE_URL=https://ocr.choira.io
OCR_REQUEST_TIMEOUT_MS=30000
# Blanket OCR kill-switch (all doc types) - set to false if ocr.choira.io is flaky and you need to
# test the chat flow without getting stuck on upload confirmation/retry steps.
OCR_ENABLED=true

# Typebot (backend-driven relay - see modules/conversation/services/typebot/)
# TYPEBOT_PREVIEW_MODE=true tests against an unpublished bot via its internal id; flip to
# false once the bot is published, with TYPEBOT_ID updated to the real publicId.
TYPEBOT_API_BASE_URL=https://typebot.io
TYPEBOT_ID=
TYPEBOT_PREVIEW_MODE=false
TYPEBOT_API_TOKEN=
TYPEBOT_REQUEST_TIMEOUT_MS=15000
MAX_UPLOAD_SIZE_MB=10

# SMTP / Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The envelope/visible "From" address - separate from SMTP_USER (the auth identity). Required on
# relays where SMTP_USER isn't a real mailbox (e.g. ZeptoMail's fixed username "emailapikey").
# Falls back to SMTP_USER when unset.
SMTP_FROM=

# Email OTP configuration
EMAIL_OTP_LENGTH=4
EMAIL_OTP_EXPIRY_MINUTES=2
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# PayU Payment Gateway
PAYU_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://test.payu.in
PAYU_WEBSERVICE_URL=https://test.payu.in/merchant/postservice.php?form=2
# Where PayU itself POSTs the payment result to - this backend's own /payment/callback, publicly
# reachable. Required for PayU to ever reach us at all: "localhost" means PayU's own machine, so
# the postback never arrives and the payment stays PENDING forever.
# Local testing: cloudflared tunnel --url http://localhost:4000, then paste the hostname here.
# localtunnel (loca.lt) does NOT work - its interstitial page intercepts PayU's browser POST.
PAYU_CALLBACK_URL=https://<your-tunnel-or-domain>/payment/callback
# Where the member's browser lands afterward, once we've processed PayU's callback - real frontend
# pages, not PayU's own.
PAYU_SUCCESS_URL=https://test.iprs.choira.io/payment/success
PAYU_FAILURE_URL=https://test.iprs.choira.io/payment/failure
PAYU_REQUEST_TIMEOUT_MS=15000


